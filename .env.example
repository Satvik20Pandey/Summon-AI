# --- FalkorDB (one graph per developer is created inside this instance) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false

# --- Summon API ---
SUMMON_API_URL=http://localhost:8787
SUMMON_API_TOKEN=change-me            # shared secret between the hooks/MCP server on your PC and the API
SUMMON_VOICE=mock                     # mock | sandbox | shravan

# --- Developer (you) ---
SUMMON_DEVELOPER_ID=satvik
SUMMON_DEVELOPER_NAME=Satvik
SUMMON_DEVELOPER_PHONE=+91XXXXXXXXXX  # only used by sandbox/shravan modes; stored hashed in the graph
SUMMON_TIMEZONE=Asia/Kolkata          # quiet hours are evaluated in this zone

# --- Curator LLM (any OpenAI-compatible endpoint; Groq shown) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Shravan.ai voice provider (only for SUMMON_VOICE=sandbox|shravan) ---
SHRAVAN_BASE_URL=https://api.shravan-ai.tech/v1
SHRAVAN_API_KEY=                      # sk_test_... for sandbox, sk_live_... for real calls
SHRAVAN_AGENT_ID=                     # filled by `summon setup`
SHRAVAN_WEBHOOK_SECRET=               # filled by `summon setup`
